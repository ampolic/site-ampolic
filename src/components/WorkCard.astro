---
// TODO(ampolic-ui@0.2.0): switch import once released — generalized copy lives in @ampolic/ui.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  name: string;
  body: string;
  url: string;
  image: ImageMetadata;
  imageAlt?: string;
  linkLabel?: string;
  headingLevel?: 2 | 3;
}
const { name, body, url, image, imageAlt, linkLabel = 'Visit Website', headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as const;
---
<div class="flex h-full flex-col overflow-hidden rounded-(--radius-base) border border-line bg-surface shadow-card">
  <Image
    src={image}
    alt={imageAlt ?? `Screenshot of the ${name} website`}
    width={720}
    height={480}
    loading="lazy"
    class="aspect-[3/2] w-full border-b border-line object-cover object-top"
  />
  <div class="flex flex-1 flex-col p-6">
    <Heading class="font-display text-xl font-semibold tracking-tight">{name}</Heading>
    <p class="mt-3 flex-1 text-text-muted">{body}</p>
    <a
      href={url}
      target="_blank"
      rel="noopener"
      class="mt-6 inline-flex min-h-11 items-center justify-center rounded-(--radius-base) border border-line px-5 font-medium text-text hover:border-brand hover:text-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
    >{linkLabel} <span class="sr-only">— {name} (opens in a new tab)</span></a>
  </div>
</div>
