---
// TODO(ampolic-ui@0.2.0): switch import once released — generalized copy lives in @ampolic/ui.
/* Renders the pricing tiers from site.ts. Strikethrough regular price + current
   promo price; the `featured` tier gets a brand border. Token-driven only. */
import { site } from '../config/site';
import { Button } from '@ampolic/ui';
---
<div class="grid gap-6 lg:grid-cols-3" data-stagger>
  {site.pricing.map((tier) => (
    <div
      class:list={[
        'flex h-full flex-col rounded-(--radius-base) border bg-surface p-7 shadow-card',
        tier.featured ? 'border-brand' : 'border-line',
      ]}
    >
      {tier.featured ? (
        <p class="font-mono text-xs uppercase tracking-[0.15em] text-brand">Most popular</p>
      ) : (
        <p class="font-mono text-xs uppercase tracking-[0.15em] text-text-muted" aria-hidden="true">&nbsp;</p>
      )}
      <h3 class="mt-3 font-display text-2xl font-semibold tracking-tight">{tier.name}</h3>
      <p class="mt-4 flex items-baseline gap-2">
        <s class="text-text-muted">
          <span class="sr-only">Regular price </span>{tier.regular}{tier.period}
        </s>
        <span class="font-display text-4xl font-semibold text-text">{tier.price}</span>
        <span class="text-text-muted">{tier.period}</span>
      </p>
      <p class="mt-3 text-text-muted">{tier.blurb}</p>
      <ul class="mt-6 flex-1 space-y-2 text-text-muted">
        {tier.features.map((f) => (
          <li class="flex gap-2"><span aria-hidden="true" class="text-brand">✓</span>{f}</li>
        ))}
      </ul>
      <div class="mt-8">
        <Button href={site.cta.href} variant={tier.featured ? 'solid' : 'outline'}>{site.cta.label}</Button>
      </div>
    </div>
  ))}
</div>
