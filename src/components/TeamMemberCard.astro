---
// TODO(ampolic-ui@0.2.0): switch import once released — generalized copy lives in @ampolic/ui.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  name: string;
  role: string;
  bio: string;
  photo: ImageMetadata;
  photoAlt?: string;
  linkLabel?: string;
  linkHref?: string;
}
const { name, role, bio, photo, photoAlt, linkLabel, linkHref } = Astro.props;
---
<div class="flex h-full flex-col overflow-hidden rounded-(--radius-base) border border-line bg-surface shadow-card">
  <Image
    src={photo}
    alt={photoAlt ?? `Portrait of ${name}`}
    width={720}
    height={720}
    loading="lazy"
    class="aspect-square w-full border-b border-line object-cover object-top"
  />
  <div class="flex flex-1 flex-col p-6">
    <h2 class="font-display text-xl font-semibold tracking-tight">{name}</h2>
    <p class="mt-1 font-medium text-brand">{role}</p>
    <p class="mt-4 flex-1 text-text-muted">{bio}</p>
    {linkLabel && linkHref && (
      <a
        href={linkHref}
        target="_blank"
        rel="noopener"
        class="mt-6 inline-flex min-h-11 items-center justify-center rounded-(--radius-base) border border-line px-5 font-medium text-text hover:border-brand hover:text-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
      >{linkLabel}</a>
    )}
  </div>
</div>
