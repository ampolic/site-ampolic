---
import { site } from '../config/site';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { EmailLink, PoweredByAmpolic } from '@ampolic/ui';
import logo from '../assets/images/ampolic-logo.png';
const year = new Date().getFullYear();
const digits = site.phone.replace(/\D/g, '').slice(-10);
const phoneLabel = `(${digits.slice(0, 3)}) ${digits.slice(3, 6)}-${digits.slice(6)}`;
// Dark navy footer like the live site — scrim/on-hero are constant across themes.
---
<footer class="bg-scrim text-on-hero">
  <div class="mx-auto grid max-w-6xl px-6 py-14 lg:grid-cols-[1.2fr_0.8fr_1fr] lg:px-4 lg:py-16">
    <div class="pb-10 text-center lg:pr-16 lg:pb-0 lg:text-left">
      <div class="flex items-center justify-center gap-3 lg:justify-start">
        <Image src={logo} alt="" width={80} height={80} class="size-14 rounded-full lg:size-11" loading="lazy" />
        <p class="font-display text-3xl font-semibold tracking-tight lg:text-2xl">{site.name}</p>
      </div>
      <p class="mx-auto mt-7 max-w-[31ch] text-lg leading-relaxed text-on-hero/75 lg:mx-0">{site.description}</p>
    </div>

    <nav class="border-on-hero/15 border-t py-10 text-center lg:border-t-0 lg:border-l lg:px-16 lg:py-0 lg:text-left" aria-label="Footer">
      <p class="font-display text-2xl font-semibold tracking-tight">Pages</p>
      <div class="mt-7 flex flex-col items-center gap-4 text-lg text-on-hero/80 lg:items-start">
        {site.nav.map((i) => <a href={i.href} class="hover:text-brand hover:underline">{i.label}</a>)}
      </div>
    </nav>

    <div class="border-on-hero/15 border-t pt-10 pb-6 text-center lg:border-t-0 lg:border-l lg:py-0 lg:pl-16 lg:text-left">
      <p class="font-display text-2xl font-semibold tracking-tight">Contact</p>
      <div class="mt-7 space-y-5 text-lg text-on-hero/80">
        <p class="flex items-center justify-center gap-4 lg:justify-start"><Icon name="lucide:phone" class="text-brand size-6 shrink-0" /><a href={`tel:${site.phone}`} class="hover:text-brand hover:underline">{phoneLabel}</a></p>
        <p class="flex items-center justify-center gap-4 lg:justify-start"><Icon name="lucide:mail" class="text-brand size-6 shrink-0" /><EmailLink email={site.email} class="hover:text-brand hover:underline" /></p>
        <p class="flex items-center justify-center gap-4 lg:justify-start"><Icon name="lucide:map-pin" class="text-brand size-6 shrink-0" />{site.serviceArea}</p>
      </div>
      <div class="mt-8 flex flex-wrap justify-center gap-3 lg:justify-start">
        {site.socials.map((s) => (
          <a href={s.href} aria-label={s.label}
             class="border-on-hero/30 text-on-hero/90 hover:border-brand hover:text-brand inline-grid size-12 place-items-center rounded-full border transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-hero lg:rounded-(--radius-base)">
            <Icon name={s.icon} class="size-6" />
          </a>
        ))}
      </div>
    </div>
  </div>
  <div class="border-t border-on-hero/15">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-5 px-6 py-7 text-center text-sm text-on-hero/70 lg:flex-row lg:flex-wrap lg:justify-between lg:px-4 lg:text-left">
      <p>© {year} {site.legalName}</p>
      <nav class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2" aria-label="Legal">
        <a href="/privacy" class="hover:text-on-hero">Privacy</a>
        <span class="bg-on-hero/30 block h-4 w-px" aria-hidden="true"></span>
        <a href="/terms" class="hover:text-on-hero">Terms</a>
        <span class="bg-on-hero/30 block h-4 w-px" aria-hidden="true"></span>
        <a href="/accessibility" class="hover:text-on-hero">Accessibility</a>
      </nav>
      {site.credit.enabled && (
        <PoweredByAmpolic
          href={site.credit.url}
          class="!border-on-hero/20 !text-on-hero/70 hover:!border-[var(--color-ampolic)] hover:!text-on-hero focus-visible:!outline-on-hero"
        />
      )}
    </div>
  </div>
</footer>
