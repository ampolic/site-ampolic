---
import Base from '../layouts/Base.astro';
import { CtaBand } from '@ampolic/ui';
import TeamMemberCard from '../components/TeamMemberCard.astro';
import { site } from '../config/site';
import samPhoto from '../assets/images/sam-scherf.jpg';
import dylanPhoto from '../assets/images/dylan-logan.jpeg';

const bio =
  'As a lifelong learner passionate about technology, I am seeking opportunities where I can continue to grow, tackle new challenges and contribute to a team. I am a dedicated software developer and system administrator with experience building systems, secure infrastructure, and creating solutions for a variety of small and medium businesses I have worked with';

const members = [
  { name: 'Sam Scherf', role: 'CEO / Co-Owner', url: 'https://samscherf.com', photo: samPhoto, bio },
  { name: 'Dylan Logan', role: 'CTO / Co-Owner', url: 'https://dylanlogan.xyz', photo: dylanPhoto, bio },
];
---
<Base title="Meet the Team" description={`Meet the people behind ${site.name} — the Toledo, Ohio team building premium, affordable websites.`}>
  <section class="py-(--spacing-section)">
    <div class="mx-auto max-w-6xl px-4">
      <h1 class="font-display text-4xl font-semibold text-balance sm:text-5xl">Meet the Team</h1>
      <p class="mt-5 max-w-[52ch] text-lg text-text-muted">Meet the people behind Ampolic Digital Solutions.</p>
    </div>
  </section>
  <section class="bg-surface-alt py-(--spacing-section)">
    <div class="mx-auto max-w-6xl px-4">
      <div class="mx-auto grid max-w-3xl gap-6 md:grid-cols-2" data-stagger>
        {members.map((m) => (
          <TeamMemberCard name={m.name} role={m.role} bio={m.bio} photo={m.photo} linkLabel="Visit Website" linkHref={m.url} />
        ))}
      </div>
    </div>
  </section>
  <CtaBand heading="Work with us on your next website" ctaLabel={site.cta.label} ctaHref={site.cta.href} />
</Base>
