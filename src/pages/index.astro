---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { PricingTiers } from '@ampolic/ui';
import ContactForm from '../components/ContactForm.astro';
import { SectionHeading, Card, FaqList, EmailLink, Button } from '@ampolic/ui';
import { Icon } from 'astro-icon/components';
import { site } from '../config/site';
import heroImage from '../assets/images/hero.jpg';

const services = (await getCollection('services'))
  .filter((s) => s.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const faqEntries = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
const pricingTiers = (await getCollection('pricing'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((t) => t.data);
const faqItems = await Promise.all(
  faqEntries.map(async (f) => ({
    question: f.data.question,
    icon: f.data.icon,
    Content: (await render(f)).Content,
  }))
);

// Display phone: +1-419-740-1850 → (419) 740-1850
const digits = site.phone.replace(/\D/g, '').slice(-10);
const phoneLabel = `(${digits.slice(0, 3)}) ${digits.slice(3, 6)}-${digits.slice(6)}`;

// Homepage title models the local-SEO convention: "[primaryService] in [city] | [name]".
const homeTitle = `${site.primaryService} in ${site.city} | ${site.name}`;

const spec = [`Est. ${site.trust.established}`, `${site.city}, ${site.address.region}`, 'Month-to-month, no contracts', 'Launch in 1–2 weeks'];

const why = [
  {
    title: 'Custom-built, not a template',
    body: 'Every site is hand-built from scratch — no page builders, no bloat. That means faster load times and cleaner SEO.',
  },
  {
    title: 'Everything handled for you',
    body: 'Hosting, domain, SEO, security, and updates are all included in one monthly fee. You run your business; we run your website.',
  },
  {
    title: 'Real people, real support',
    body: `We're a Toledo-based team, and we reply within 1–2 business days — by email or phone, no ticket maze.`,
  },
  {
    title: 'No lock-in',
    body: 'Every plan is month-to-month. If you ever cancel, you keep your domain and your website files.',
  },
];

const process = [
  { step: '01', icon: 'lucide:message-circle-more', title: 'Reach out', body: 'We discuss your business needs and goals.' },
  { step: '02', icon: 'lucide:square-pen', title: 'We build together', body: 'We draft the design and content; you review and refine it until it sounds like you.' },
  { step: '03', icon: 'lucide:rocket', title: 'Launch in 1–2 weeks', body: 'Your site goes live with hosting, SSL, and SEO setup handled.' },
  { step: '04', icon: 'lucide:shield-check', title: 'We keep it running', body: 'Ongoing updates and maintenance are part of your plan.' },
];
---
<Base title={homeTitle} description={site.description}>
  <Hero
    eyebrow="Digital marketing for small businesses"
    headline={site.name}
    subhead={site.description}
    ctaLabel={site.cta.label}
    ctaHref={site.cta.href}
    secondaryLabel="Learn More"
    secondaryHref="/#about"
    image={heroImage}
    imageAlt=""
  />

  <!-- Spec strip: credibility as one mono data row -->
  <section class="border-y border-line" aria-label="Company facts">
    <ul class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-8 gap-y-3 px-4 py-5 font-mono text-xs uppercase tracking-[0.12em] text-text-muted sm:text-sm">
      {spec.map((item) => (
        <li class="flex items-center gap-8" data-spec><span class="text-text">{item}</span></li>
      ))}
    </ul>
  </section>

  <section id="about" class="py-(--spacing-section)">
    <div class="mx-auto max-w-6xl px-4" data-reveal>
      <SectionHeading eyebrow="About" heading="Don't Settle For Less" />
      <p class="mt-6 max-w-[65ch] text-lg text-text-muted">
        Ampolic Digital Solutions specializes in helping small businesses grow their online presence
        through custom-built, optimized websites. Established in 2020 and based in Toledo, Ohio, we
        believe every business deserves a premium website — without the premium agency price tag.
      </p>
    </div>
  </section>

  <section id="why" class="bg-surface-alt py-(--spacing-section)">
    <div class="mx-auto max-w-6xl px-4">
      <div data-reveal><SectionHeading eyebrow="Why Ampolic" heading="Why Ampolic instead of a DIY website builder?" /></div>
      <div class="mt-12 grid gap-6 md:grid-cols-2" data-stagger>
        {why.map((w) => (
          <Card>
            <h3 class="font-display text-xl font-semibold tracking-tight">{w.title}</h3>
            <p class="mt-2 text-text-muted">{w.body}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section id="solutions" class="py-(--spacing-section)">
    <div class="mx-auto max-w-6xl px-4">
      <div data-reveal><SectionHeading eyebrow="What we do" heading="Solutions" /></div>
      <div class="mt-12 grid gap-6 md:grid-cols-3" data-stagger>
        {services.map((s, i) => (
          <ServiceCard
            title={s.data.title}
            summary={s.data.summary}
            icon={s.data.icon}
            href={`/services/${s.id}`}
            index={String(i + 1).padStart(2, '0')}
          />
        ))}
      </div>
    </div>
  </section>

  <section id="process" class="bg-surface-alt py-(--spacing-section)">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid items-center gap-10 lg:grid-cols-2" data-reveal>
        <div>
          <p class="text-brand font-mono text-sm font-semibold tracking-wider uppercase">Process</p>
          <h2 class="font-display mt-3 text-4xl font-semibold text-balance sm:text-5xl">How it works</h2>
          <p class="text-text-muted mt-5 max-w-[48ch] text-lg">
            A simple, proven process to take your project from idea to launch&mdash;and beyond.
          </p>
          <span class="bg-brand mt-6 block h-1 w-16 rounded-full" aria-hidden="true"></span>
        </div>
        <!-- Decorative CSS "browser window" with rocket chip — no image assets. -->
        <div class="relative mx-auto hidden h-64 w-full max-w-md lg:block" aria-hidden="true">
          <span class="bg-brand/10 absolute -top-4 right-8 size-44 rounded-full"></span>
          <div class="border-line bg-surface shadow-card absolute top-6 right-0 w-80 rounded-(--radius-base) border">
            <div class="border-line flex items-center gap-1.5 border-b px-4 py-3">
              <span class="bg-line size-2.5 rounded-full"></span>
              <span class="bg-line size-2.5 rounded-full"></span>
              <span class="bg-brand/40 size-2.5 rounded-full"></span>
            </div>
            <div class="flex gap-4 p-5">
              <span class="bg-surface-alt h-24 w-24 shrink-0 rounded-md"></span>
              <span class="flex-1 space-y-2.5">
                <span class="bg-line block h-2 w-full rounded"></span>
                <span class="bg-line block h-2 w-5/6 rounded"></span>
                <span class="bg-line block h-2 w-2/3 rounded"></span>
                <span class="bg-brand mt-4 block h-6 w-16 rounded-md"></span>
              </span>
            </div>
          </div>
          <div class="border-line bg-surface shadow-card absolute bottom-2 left-10 flex size-16 items-center justify-center rounded-(--radius-base) border">
            <Icon name="lucide:rocket" class="text-brand size-7" />
          </div>
        </div>
      </div>
      <ol class="mt-16 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        {process.map((p, i) => (
          <li class="relative flex flex-col items-center">
            <span class="bg-surface shadow-card z-10 flex size-16 items-center justify-center rounded-full">
              <span class="bg-brand/10 text-brand flex size-12 items-center justify-center rounded-full">
                <Icon name={p.icon} class="size-6" />
              </span>
            </span>
            <div class="border-line bg-surface shadow-card -mt-8 w-full rounded-(--radius-base) border px-6 pt-12 pb-6 text-center">
              <p class="text-brand font-display text-3xl font-semibold">{p.step}</p>
              <h3 class="font-display mt-2 text-lg font-semibold tracking-tight">{p.title}</h3>
              <p class="text-text-muted mt-2 text-sm">{p.body}</p>
            </div>
            {i < process.length - 1 && (
              <span class="absolute top-24 right-0 hidden translate-x-1/2 items-center lg:flex" aria-hidden="true">
                <span class="bg-brand/40 h-px w-4"></span>
                <span class="bg-brand text-brand-contrast flex size-7 items-center justify-center rounded-full">
                  <Icon name="lucide:chevron-right" class="size-4" />
                </span>
                <span class="bg-brand/40 h-px w-4"></span>
              </span>
            )}
          </li>
        ))}
      </ol>
      <p class="text-text-muted mt-12 flex items-center justify-center gap-2" data-reveal>
        <Icon name="lucide:shield-check" class="text-brand size-5" aria-hidden="true" />
        Clear steps. Great communication. Results that last.
      </p>
    </div>
  </section>

  <section id="pricing" class="py-(--spacing-section)">
    <div class="mx-auto max-w-6xl px-4">
      <div data-reveal>
        <SectionHeading eyebrow="Pricing" heading="Simple monthly plans" lede="No contracts, no surprise invoices. Every plan includes hosting, domain, and support." />
      </div>
      <div class="mt-12">
        <PricingTiers tiers={pricingTiers} ctaLabel="Get started" ctaHref="/#contact" />
      </div>
    </div>
  </section>

  <section id="faq" class="bg-surface-alt py-(--spacing-section)">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-14">
        <div class="space-y-8" data-reveal>
          <div>
            <p class="text-brand font-mono text-sm font-semibold tracking-wider uppercase">FAQ</p>
            <h2 class="font-display mt-3 text-4xl font-semibold text-balance sm:text-5xl">Common Questions</h2>
            <p class="text-text-muted mt-5 max-w-[42ch] text-lg">
              Everything you need to know before getting started. If you don't see your question here,
              reach out&mdash;we're happy to help.
            </p>
          </div>
          <Card>
            <span class="bg-brand/10 text-brand flex size-12 items-center justify-center rounded-full" aria-hidden="true">
              <Icon name="lucide:message-circle-question" class="size-6" />
            </span>
            <h3 class="font-display mt-4 text-xl font-semibold">Still have questions?</h3>
            <p class="text-text-muted mt-2">We're here to help you make the right decision.</p>
            <div class="mt-5"><Button href="/#contact">Book a free strategy call</Button></div>
          </Card>
        </div>
        <div data-reveal><FaqList items={faqItems} /></div>
      </div>
      <ul class="mt-14 grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-4" data-stagger>
        {
          [
            { icon: 'lucide:shield-check', title: 'No lock-ins', sub: 'Cancel anytime' },
            { icon: 'lucide:user-check', title: '100% ownership', sub: 'You own everything' },
            { icon: 'lucide:message-square', title: 'Clear communication', sub: 'We keep you in the loop' },
            { icon: 'lucide:life-buoy', title: 'Ongoing support', sub: "We're here when you need us" },
          ].map((t) => (
            <li class="flex items-start gap-3">
              <span class="bg-brand/10 text-brand flex size-10 shrink-0 items-center justify-center rounded-full" aria-hidden="true">
                <Icon name={t.icon} class="size-5" />
              </span>
              <div>
                <p class="font-medium">{t.title}</p>
                <p class="text-text-muted text-sm">{t.sub}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="contact" class="py-(--spacing-section)">
    <div class="mx-auto max-w-6xl px-4">
      <div data-reveal><SectionHeading eyebrow="Contact" heading="Let's talk about your website" /></div>
      <div class="mt-10 grid gap-12 lg:grid-cols-2 lg:items-start">
        <div class="space-y-3">
          <p class="max-w-[52ch] text-text-muted">
            Tell us about your business and we'll get back to you within one to two business days.
          </p>
          <p><a href={`tel:${site.phone}`} class="text-brand hover:underline">{phoneLabel}</a></p>
          <p><EmailLink email={site.email} class="text-brand hover:underline" /></p>
          <p class="text-text-muted">{site.serviceArea}</p>
        </div>
        <div><ContactForm /></div>
      </div>
    </div>
  </section>
</Base>
